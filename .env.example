# Azure OpenAI (required -- there is no offline fallback):
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: only needed if you select "Azure OpenAI embeddings" retrieval
# (requires an embeddings model, e.g. text-embedding-3-small, deployed under
# the same resource above).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
